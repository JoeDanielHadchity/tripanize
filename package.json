{
  "name": "tripanize",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "prisma generate && vite build",
    "start": "wrangler dev --local --config dist/server/wrangler.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:cloudflare": "npm run build",
    "preview": "wrangler dev --local --config dist/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "test:cloudflare": "node scripts/check-cloudflare.mjs storage && node scripts/check-cloudflare.mjs app"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^7.10.1",
    "@prisma/driver-adapter-utils": "^7.10.1",
    "@vinext/cloudflare": "1.2.0",
    "better-auth": "^1.7.11",
    "dotenv": "^18.0.8",
    "leaflet": "^1.9.4",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "openai": "^7.39.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@playwright/test": "^1.64.1",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vinext": "^1.3.0",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
