# Required
DATABASE_URL=postgresql://user:password@host:5432/tripanize
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=https://your-tripanize-domain.example
APP_URL=https://your-tripanize-domain.example

# AI planning (server-side only). Without it, "Plan with AI" explains that AI is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
# Set to "false" to disable the OpenAI web_search tool (used for current opening hours and events).
OPENAI_WEB_SEARCH=true

# Email delivery: sign-in codes, password reset, invitations and event alerts.
# Resend (https://resend.com) is used when RESEND_API_KEY is set; otherwise any SMTP server via SMTP_URL.
# Without either, code sign-in is unavailable and users sign in with a password.
RESEND_API_KEY=
SMTP_URL=
# Must use a domain you verified in Resend. For a first test you can use "Tripanize <onboarding@resend.dev>",
# which Resend only delivers to the email address of your own Resend account.
EMAIL_FROM="Tripanize <trips@your-tripanize-domain.example>"

# Optional live routing (openrouteservice.org). Without it, travel times are labeled estimates.
ORS_API_KEY=

# Private attachment storage directory (outside the public web root).
STORAGE_DIR=./storage
