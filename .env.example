# Production URLs are configured in wrangler.jsonc.
APP_URL=https://tripanize.app
BETTER_AUTH_URL=https://tripanize.app
EMAIL_FROM="Tripanize <hello@tripanize.app>"

# Local Prisma migration tools only; production uses Durable Object SQLite.
DATABASE_URL=file:./dev.sqlite

# Hosting-first release: leave external integrations disconnected.
# Complete the Cloudflare background-job integration before enabling AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_WEB_SEARCH=true
RESEND_API_KEY=
SMTP_URL=
ORS_API_KEY=
