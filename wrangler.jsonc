{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tripanize",
  "workers_dev": false,
  "preview_urls": false,
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP",
        "class_name": "TripanizeApp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TripanizeApp"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "tripanize-attachments"
    }
  ],
  "vars": {
    "APP_URL": "https://tripanize.app",
    "BETTER_AUTH_URL": "https://tripanize.app",
    "OPENAI_MODEL": "gpt-6.1-sol",
    "OPENAI_WEB_SEARCH": "true",
    "EMAIL_FROM": "Tripanize <hello@tripanize.app>",
    "PLAN_ACCESS_ENABLED": "true",
    "PADDLE_ENVIRONMENT": "live",
    "PADDLE_CHECKOUT_ENABLED": "true",
    "PADDLE_PRICE_900": "pri_01m5j5asrjaa1ktb24g3xyw0n1",
    "PADDLE_PRICE_1500": "pri_01m5j5d0wvpvrhjmzdq1ph03z7",
    "PADDLE_PRICE_2500": "pri_01m5j5eyyj0w0hearvf1akegjw",
    "PADDLE_PRICE_600": "pri_01m5j5gw7t8dbxj8wfdahgbjsq",
    "PADDLE_PRICE_1000": "pri_01m5j5jn3chjr7ga2xh4btyvd3",
    "PADDLE_PRICE_1600": "pri_01m5j5kq99jtcr0x19bww29da0"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "tripanize.app",
      "custom_domain": true,
      "previews_enabled": true
    },
    {
      "pattern": "www.tripanize.app",
      "custom_domain": true
    }
  ]
}
