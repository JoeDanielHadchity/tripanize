{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tripanize",
  "workers_dev": true,
  "preview_urls": false,
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP",
        "class_name": "TripanizeApp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TripanizeApp"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "tripanize-attachments"
    }
  ],
  "vars": {
    "APP_URL": "https://tripanize.app",
    "BETTER_AUTH_URL": "https://tripanize.app",
    "WORKERS_DEV_URL": "https://tripanize.joedanielhadchity1.workers.dev",
    "OPENAI_MODEL": "gpt-6.1-sol",
    "OPENAI_WEB_SEARCH": "true",
    "EMAIL_FROM": "Tripanize <hello@tripanize.app>"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "tripanize.app",
      "custom_domain": true
    },
    {
      "pattern": "www.tripanize.app",
      "custom_domain": true
    }
  ]
}
