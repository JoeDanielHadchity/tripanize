{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tripanize",
  "workers_dev": true,
  "preview_urls": true,
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP",
        "class_name": "TripanizeApp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TripanizeApp"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "tripanize-attachments"
    }
  ],
  "vars": {
    "APP_URL": "https://tripanize.app",
    "BETTER_AUTH_URL": "https://tripanize.app",
    "WORKERS_DEV_URL": "https://tripanize.joedanielhadchity1.workers.dev",
    "OPENAI_MODEL": "gpt-6.1-sol",
    "OPENAI_WEB_SEARCH": "true",
    "EMAIL_FROM": "Tripanize <hello@tripanize.app>",
    "PLAN_ACCESS_ENABLED": "false",
    "PADDLE_ENVIRONMENT": "live",
    "PADDLE_CHECKOUT_ENABLED": "false",
    "PADDLE_PRICE_900": "pri_01m5j5asrjaa1ktb24g3xyw0n1",
    "PADDLE_PRICE_1500": "pri_01m5j5d0wvpvrhjmzdq1ph03z7",
    "PADDLE_PRICE_2500": "pri_01m5j5eyyj0w0hearvf1akegjw",
    "PADDLE_PRICE_600": "pri_01m5j5gw7t8dbxj8wfdahgbjsq",
    "PADDLE_PRICE_1000": "pri_01m5j5jn3chjr7ga2xh4btyvd3",
    "PADDLE_PRICE_1600": "pri_01m5j5kq99jtcr0x19bww29da0"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "APP", "class_name": "TripanizeApp" }]
    },
    "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "tripanize-sandbox-attachments" }],
    "vars": {
      "APP_URL": "https://paddle-sandbox-tripanize.joedanielhadchity1.workers.dev",
      "BETTER_AUTH_URL": "https://paddle-sandbox-tripanize.joedanielhadchity1.workers.dev",
      "WORKERS_DEV_URL": "https://paddle-sandbox-tripanize.joedanielhadchity1.workers.dev",
      "OPENAI_WEB_SEARCH": "false",
      "PLAN_ACCESS_ENABLED": "true",
      "PADDLE_ENVIRONMENT": "sandbox",
      "PADDLE_CHECKOUT_ENABLED": "true",
      "PADDLE_PRICE_900": "pri_01m5jc0t0n53paj8wfm4pb5zna",
      "PADDLE_PRICE_1500": "pri_01m5jc1twzekxpn6y12naf7f0v",
      "PADDLE_PRICE_2500": "pri_01m5jc2ch4akxsss60w7y36073",
      "PADDLE_PRICE_600": "pri_01m5jc2zncfvtanty09dv6dq3m",
      "PADDLE_PRICE_1000": "pri_01m5jc3yv2e39w6bb2tkdf8whs",
      "PADDLE_PRICE_1600": "pri_01m5jc4nbx2ebya40tjefbr34c"
    }
  },
  "routes": [
    {
      "pattern": "tripanize.app",
      "custom_domain": true
    },
    {
      "pattern": "www.tripanize.app",
      "custom_domain": true
    }
  ]
}
