{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tripanize",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP",
        "class_name": "TripanizeApp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TripanizeApp"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "tripanize-attachments"
    }
  ],
  "vars": {
    "APP_URL": "https://tripanize.app",
    "BETTER_AUTH_URL": "https://tripanize.app",
    "EMAIL_FROM": "Tripanize <hello@tripanize.app>"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "tripanize.app",
      "custom_domain": true
    }
  ]
}
